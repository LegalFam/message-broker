# Use these values when deploying the backend to Cloud Run.
# Store real secrets in Secret Manager when possible instead of committing them.

RABBITMQ_HOST=<rabbitmq-vm-internal-ip>
RABBITMQ_PORT=5672
RABBITMQ_USER=legalfam
RABBITMQ_PASSWORD=<same-password-from-rabbitmq-.env>
RABBITMQ_VHOST=/
CHAT_RABBIT_ENABLED=true

