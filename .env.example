# Copy this file to .env on the RabbitMQ VM and change the values.
# Do not commit the real .env file.

RABBITMQ_DEFAULT_USER=legalfam
RABBITMQ_DEFAULT_PASS=change-this-password
RABBITMQ_DEFAULT_VHOST=/

# Keep this stable after first boot when using a persistent volume.
RABBITMQ_NODENAME=rabbit@legalfam-rabbitmq

